---
const actividades = [
  { icon: "🌱", titulo: "Biohuerto e Invernadero" },
  { icon: "🎨", titulo: "Arteterapia" },
  { icon: "🎭", titulo: "Teatro" },
  { icon: "🎵", titulo: "Música" },
  { icon: "👁️", titulo: "Visión Extraocular" },
  { icon: "💰", titulo: "Finanzas para Niños" },
  { icon: "🧠", titulo: "Inteligencia Emocional" },
  { icon: "☀️", titulo: "Coaching de Niños" },
  { icon: "🔨", titulo: "Carpintería" },
  { icon: "🧶", titulo: "Tejido" },
  { icon: "🌎", titulo: "Quechua e Inglés" },
  { icon: "🐾", titulo: "Biología Animal" },
  { icon: "🏓", titulo: "Tenis de Mesa" },
  { icon: "⛳", titulo: "Mini Golf" },
  { icon: "⚽", titulo: "Fútbol" },
  { icon: "🏊", titulo: "Natación" },
];
---

<section class="bg-gradient-to-r from-green-800 to-green-600 py-16 px-6">
  <h2 class="text-center text-white text-3xl font-bold mb-10">
    Actividades Extracurriculares
  </h2>

  <div
    class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 justify-items-center"
  >
    {
      actividades.map((a) => (
        <span class="flex flex-col sm:flex-row items-center justify-center gap-2 px-4 py-3 w-full sm:w-auto rounded-xl bg-green-500/80 hover:bg-green-600 hover:scale-105 hover:shadow-lg text-white cursor-pointer transition-all duration-300 text-center">
          <span class="text-xl">{a.icon}</span>
          <span class="text-sm font-medium">{a.titulo}</span>
        </span>
      ))
    }
  </div>
</section>
